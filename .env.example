# ============================================================
# Discord CC Bot - environment configuration
# Copy this file to ".env" and fill in your own values.
# (Lines starting with "#" are comments.)
#
# Everything except the two [Required] entries has a working default.
# The engine ships inside this repo (server/), so there is nothing
# external to point at.
# ============================================================

# ---- Required ----------------------------------------------

# Your Discord bot token.
# Create an application at https://discord.com/developers/applications
# then open the "Bot" tab -> Reset Token -> Copy.
DISCORD_TOKEN=

# Your Discord user ID (the bot owner; only this user may control it).
# Right-click your own name -> Copy User ID (Developer Mode must be on).
ALLOWED_USER=

# ---- Bot behaviour -----------------------------------------

# Interface language: "zh-TW" (default) or "en".
# Controls both the bot's own UI text AND the language Claude replies in.
BOT_LANG=zh-TW

# Channel ID for release announcements. The bot posts a short changelog there
# the first time it starts on a new version. Empty or 0 disables it.
UPDATE_CHANNEL=

# Default working directory for new conversations.
# Defaults to your home directory. Set an absolute path to scope the bot
# to a specific folder. (BUTLER_CWD is the same setting under its newer name;
# either key works.)
DEFAULT_DIR=

# Names for the multi-conversation sidebar (category + entry channel).
# Leave empty to use the defaults. If TWO bots run in the SAME Discord server,
# give each bot a DIFFERENT SIDEBAR_CATEGORY so they don't fight over the same
# category (which causes duplicate welcome messages and crossed-up channels).
SIDEBAR_CATEGORY=
SIDEBAR_ENTRY=

# Dangerous-action confirmation. When ON, destructive commands (rm -rf,
# git push --force, shutdown, etc.) pop a Discord confirm button before running.
# Defaults to OFF (commands run without asking). Set to 1 to turn it on, or
# toggle it at runtime with /confirm.
CONFIRM_DANGEROUS=

# Where the bot keeps its state (sessions, titles, schedules, model choice).
# Defaults to the "data" folder inside this repo.
LU_DATA_DIR=

# ---- Claude engine -----------------------------------------
# These are read by the engine in server/, not by the Discord layer.
# All of them can also be changed at runtime with slash commands.

# Default model for new conversations. Defaults to "claude-sonnet-4-6"
# (standard 200K context), which works on every plan and needs no usage credits.
# Leaving this empty is recommended -- use /model to switch at runtime.
# If your plan has 1M-context credits and you want the 1M window, use the 1M
# alias (e.g. "claude-sonnet-4-6[1m]"); the auto-compaction threshold follows.
DEFAULT_MODEL=

# Default reasoning effort: low | medium | high. Defaults to medium.
# Runtime equivalent: /effort
DEFAULT_EFFORT=

# Your Claude subscription plan, so the engine can apply Anthropic's official
# 1M-context rule automatically. One of: pro | max | enterprise | api.
# On max/enterprise, Opus automatically uses the 1M window (no credits needed);
# other cases stay at 200K unless you use a "[1m]" model alias.
# Runtime equivalent: /plan
BUTLER_PLAN=

# Which personality file under server/personas/ to load (without the .txt).
# Defaults to "default". Ships with: default, work, example-tsundere.
# These are plain text -- copy one, edit the tone, point this at it.
BUTLER_PERSONA=

# Path to the Claude Code CLI executable. Leave empty: the SDK ships its own
# matching CLI and finding it itself is the version-safe behaviour. Only set
# this if you specifically need to run against a different install.
CLAUDE_CLI=

# ---- Optional extras ---------------------------------------

# Temporary download links for files too big to upload to Discord.
# Point SHARE_SCRIPT at a PowerShell script invoked as
#   <script> <file> -As <name> -Hours <n>
# that prints a download URL to stdout (cloudflared, ngrok, an upload CLI...).
# Leave empty to keep the default: oversized files are just reported by path.
SHARE_SCRIPT=
# How long the link should stay alive, in hours. Defaults to 24.
SHARE_HOURS=

# Override which engine to run against. Normally leave this empty -- the engine
# lives in this repo's server/ folder. Only useful if you keep a separate
# checkout and want both front-ends to share one copy.
BUTLER_SERVER_DIR=
