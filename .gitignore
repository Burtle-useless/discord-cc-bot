# Environment config (contains your token - never commit this)
.env

# Bot runtime data (generated at runtime, user-specific)
data/
# Belt and braces: if BUTLER_DATA_DIR ever fails to get set before the engine's
# config is imported, state lands here instead. Never commit it either way.
server/data/
# Pre-2.0 layout -- migrate_state.py copies these into data/ and leaves the
# originals alone, so they stay on disk after upgrading.
discord_session.json
allowed_users.json
allowed_channels.json
schedules.json
session_titles.json
account_plan.json
drive_mode.json
user_messages.jsonl

# Logs
*.log
*.err
logs/

# Python
__pycache__/
*.pyc
*.pyo

# Temp
tmp/

# 使用者端說明書，不是公開版的一部分
_說明書/

# Semantic /search vector cache (generated at runtime, can be tens of MB)
session_vectors.json
session_vectors_e5.json

# 同步用的臨時腳本（比對上游、逐檔跑測試）。只擋根目錄這一層，裡面寫著本機的
# 絕對路徑，進版控等於把那條路徑公開出去
/_*.py

# impeccable hook 的本機快取：裡面是這台機器的絕對路徑
.impeccable/
